  "app_help_owned_operators_page_content": {
    "value": [
      "Open schedule setup",
      "Return to the Infrastructure Calculator. On desktop, select “Configure BOX & base” at the top. On mobile, open “More tools” first."
    ]
  },
  "app_help_owned_operators_page_content2": {
    "value": [
      "Return to step 1, “Operator Data”",
      "If the dialog opens on layout or facilities, leave it open and select “Operator Data” at the left of the progress bar."
    ]
  },
  "app_help_owned_operators_page_content3": {
    "value": [
      "Select “Change” beside the current data",
      "Expand the data-source choices. Do not use “Import all operators” outside the dialog; it loads a max-level sample for demonstration."
    ]
  },
  "app_help_owned_operators_page_content4": {
    "value": [
      "Import your own Box",
      "Either sync with Skland or upload Arknights_OperBox_Export.json exported by MAA."
    ]
  },
  "app_help_owned_operators_page_content5": {
    "value": [
      "Finish setup and generate again",
      "Follow the prompts to continue or check facilities, verify the layout and facilities, then select “Finish”. Return to the calculator and generate a new schedule."
    ]
  }
