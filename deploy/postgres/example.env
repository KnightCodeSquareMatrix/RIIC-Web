# Copy separately to production.env and development.env with different random values; chmod 0600.
POSTGRES_DB=arknights_infra_auth
POSTGRES_USER=arknights_bootstrap
POSTGRES_PASSWORD=replace-with-random-bootstrap-password
AUTH_RUNTIME_USER=arknights_runtime
AUTH_RUNTIME_PASSWORD=replace-with-random-runtime-password
AUTH_MIGRATION_USER=arknights_migration
AUTH_MIGRATION_PASSWORD=replace-with-random-migration-password
AUTH_BACKUP_USER=arknights_backup
AUTH_BACKUP_PASSWORD=replace-with-random-backup-password
