# Template only; configure DATABASE_URL through the existing secret mechanism.
# Website and private worker must share DATABASE_URL and the private storage root.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
ADMIN_QUALITY_STORAGE_DIR=/var/lib/arknights-infra-quality-private
ADMIN_QUALITY_PRODUCTION_CLI=/opt/arknights-infra/shared/bin/infra-cli
ADMIN_QUALITY_PRODUCTION_SHA256=/opt/arknights-infra/shared/bin/infra-cli.sha256
# Set only when the published CLI uses matching external runtime data.
# ADMIN_QUALITY_PRODUCTION_DATA=/absolute/path/to/published/matching/data
