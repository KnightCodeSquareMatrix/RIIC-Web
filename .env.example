# Optional local paths for a solver binary and its data directory.
INFRA_CLI_PATH=
ARKNIGHTS_INFRA_DATA_DIR=

# Authentication is initialized lazily; these are required only for auth requests and migrations.
APP_DEPLOYMENT_ENV=development
# Local-only preview switch. Code also requires plain HTTP on a loopback host
# at port 5174 and requires both deployment markers to equal development.
LOCAL_AUTH_BYPASS=0
NEXT_PUBLIC_DEFAULT_LOCALE=zh
# production enables Skland only for the exact value 1; development/local can use 0 to disable it.
SKLAND_FEATURE_ENABLED=1
SKLAND_SESSION_SECRET=replace-with-at-least-32-random-bytes
BETA_PUBLIC_ORIGIN=http://127.0.0.1:5174
SKLAND_PUBLIC_ORIGIN=http://127.0.0.1:5174
DATABASE_URL=postgresql://arknights_runtime:change-me@127.0.0.1:55433/arknights_infra_auth
DATABASE_MIGRATION_URL=postgresql://arknights_migration:change-me@127.0.0.1:55433/arknights_infra_auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://127.0.0.1:5174
BETTER_AUTH_ADMIN_USER_IDS=
RESEND_API_KEY=
AUTH_EMAIL_FROM=基建排班助手 <auth@example.com>

# Business-data phases are enabled independently after migrations and observation.
BETA_BUSINESS_DB_ENABLED=0
BETA_BUSINESS_DB_READ_ENABLED=0
BETA_BUSINESS_FILE_READ_FALLBACK=1
ACCOUNT_CLOUD_SYNC_ENABLED=0
# JSON object whose values use base64:... and decode to exactly 32 bytes.
WORKSPACE_ACTIVE_KEY_VERSION=v1
WORKSPACE_MASTER_KEYS={"v1":"base64:replace-with-32-random-bytes"}
PLAN_CACHE_ENABLED=0
PLAN_CACHE_HMAC_KEY=base64:replace-with-at-least-32-random-bytes
# The queue additionally requires business DB writes, workspace keys and the cache HMAC key.
PLAN_TASK_QUEUE_ENABLED=0
# Required by the independent worker; production deployment injects the verified commit SHA.
APP_RELEASE_SHA=0000000000000000000000000000000000000000
